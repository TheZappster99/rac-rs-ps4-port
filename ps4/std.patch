+// rac-rs PS4 port: the console starts the app with no usable descriptors 1 and 2 (dup2 onto them did not reach the file), so
+// stdout and stderr go to the descriptor the app hands over here (its log file), when it has.
+#[cfg(target_os = "freebsd")]
+static RAC_LOG_FD: crate::sync::atomic::AtomicI32 = crate::sync::atomic::AtomicI32::new(-1);
+
+/// rac-rs PS4 port: send stdout and stderr to `fd` from now on (-1: back to descriptors 1 and 2).
+#[cfg(target_os = "freebsd")]
+#[unsafe(no_mangle)]
+pub extern "C" fn rac_std_set_log_fd(fd: i32) {
+    RAC_LOG_FD.store(fd, crate::sync::atomic::Ordering::Release);
+}
+
+/// rac-rs PS4 port: force the log descriptor's writes to disk (fsync); returns its result, or -1 without one.
+#[cfg(target_os = "freebsd")]
+#[unsafe(no_mangle)]
+pub extern "C" fn rac_std_sync_log() -> i32 {
+    let fd = RAC_LOG_FD.load(crate::sync::atomic::Ordering::Acquire);
+    if fd < 0 { -1 } else { unsafe { libc::fsync(fd) } }
+}
+
+fn out_fd(default: i32) -> i32 {
+    #[cfg(target_os = "freebsd")]
+    {
+        let fd = RAC_LOG_FD.load(crate::sync::atomic::Ordering::Acquire);
+        if fd >= 0 {
+            return fd;
+        }
+    }
+    default
+}
